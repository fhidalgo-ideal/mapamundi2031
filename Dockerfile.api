# Multi-stage build: Granada API with Bun
FROM oven/bun:1-alpine as base

WORKDIR /app

# Copy package files and install dependencies (production-only)
COPY package.json package-lock.json ./
RUN bun install --production

# Copy application code and configuration
COPY api/ ./api/
COPY config.json ./

# Migration runner and its migrations: the deploy runs them from inside this
# image, against the same code that is about to serve traffic.
COPY scripts/ ./scripts/
COPY migrations/ ./migrations/

# Create data and uploads directories
RUN mkdir -p /app/data /app/uploads

# Expose the API port
EXPOSE 8080

# Health check: curl GET /api/health
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/api/health || exit 1

CMD ["bun", "run", "api/server.ts", "--host", "0.0.0.0"]
