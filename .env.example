# Copy this file to .env for local development. Production values live in
# /etc/granada/.env on the server, owned by root and readable only by root;
# they are never committed here and never stored in GitHub.

# MongoDB database name (used for initialization and context)
MONGO_DB_NAME=granada2031

# Database credentials. The root account exists for administration and for
# mongodump/mongorestore; the app account only has readWrite on the database
# above. Both are created the first time MongoDB initializes an empty data
# directory — changing them later means creating the users by hand, not just
# editing this file.
MONGO_ROOT_USER=granada_root
MONGO_ROOT_PASSWORD=devrootpassword
MONGO_APP_USER=granada_app
MONGO_APP_PASSWORD=devapppassword

# Connection URI for MongoDB. Leave unset to have compose assemble it from the
# credentials above. If unset AND no MongoDB is configured, the API falls back
# to SQLite (GRANADA_DB_PATH).
# MONGO_URI=mongodb://granada_app:devapppassword@db:27017/granada2031?authSource=granada2031

# Granada Application Configuration
# Path to SQLite database file (used only when MONGO_URI is not set)
# Inside Docker, this path is mounted to /app/data/
GRANADA_DB_PATH=/app/data/granada.db

# Insert the demo traces (and copy their photos into uploads) when the database
# is empty. Useful in dev; set to false in production so a fresh deployment
# starts with no content at all.
GRANADA_SEED=true

# Path to uploads directory for trace photos
# Inside Docker, this path is mounted to /app/uploads/
GRANADA_UPLOAD_DIR=/app/uploads

# API Server Configuration
# Port the API listens on (inside the container)
API_PORT=8080

# Proxy/Gateway Configuration
# Port the Nginx proxy listens on (exposed to host)
PROXY_PORT=80
