# MongoDB Configuration
# Connection URI for MongoDB. Format: mongodb://host[:port]/database
# If unset, the API falls back to SQLite (GRANADA_DB_PATH)
MONGO_URI=mongodb://db:27017/granada2031

# MongoDB database name (used for initialization and context)
MONGO_DB_NAME=granada2031

# Granada Application Configuration
# Path to SQLite database file (used only when MONGO_URI is not set)
# Inside Docker, this path is mounted to /app/data/
GRANADA_DB_PATH=/app/data/granada.db

# Path to uploads directory for trace photos
# Inside Docker, this path is mounted to /app/uploads/
GRANADA_UPLOAD_DIR=/app/uploads

# API Server Configuration
# Port the API listens on (inside the container)
API_PORT=8080

# Proxy/Gateway Configuration
# Port the Nginx proxy listens on (exposed to host)
PROXY_PORT=80
